@model iBarber.Models.Usuario

@{
    ViewData["Title"] = "Delete";
}


<h3>Tem certeza que deseja apagar o osuario @Model.Nome</h3>
<table class="table table-bordered table-striped">
    <tbody>
        <tr>
            <th>Nome</th>
            <td>@Html.DisplayFor(model => model.Nome)</td>
        </tr>

        <tr>
            <th>Perfil</th>
            <td>@Html.DisplayFor(model => model.Perfil)</td>
        </tr>

    </tbody>
</table>
    
    <form asp-action="Delete" class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger me-2"
                onclick="return confirm('Tem certeza que deseja excluir o Usuario: ( @Model.Nome ) ?');">
            <i class="bi bi-trash"></i> Confirmar Exclusão
        </button>
    </form>
</div>
