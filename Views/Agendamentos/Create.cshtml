@model iBarber.Models.Agendamento

@{
    ViewData["Title"] = "Create";
}

<h4>Agendamento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* 1. CAMPO DE EXIBIÇÃO DO NOME DO CLIENTE LOGADO (Somente leitura) *@
            <div class="form-group">
                <label class="control-label">Cliente</label>
                <input class="form-control" value="@ViewData["NomeClienteLogado"]" disabled />
            </div>

            @* 2. CAMPO OCULTO: ID do Cliente *@
            <input type="hidden" asp-for="UsuarioId" />

            @* NOVO CAMPO 3: BARBEARIA *@
            <div class="form-group">
                <label for="BarbeariaId" class="control-label">Barbearia</label>
                <select id="BarbeariaId" name="BarbeariaId" class="form-control" asp-items="ViewBag.BarbeariaId">
                    <option value="">Selecione a Barbearia</option>
                </select>
            </div>

            @* Campo Data e Hora *@
            <div class="form-group">
                <label asp-for="DataHora" class="control-label"></label>
                <input asp-for="DataHora" class="form-control" />
                <span asp-validation-for="DataHora" class="text-danger"></span>
            </div>

            @* CAMPO 4: PROFISSIONAL (Modificado para ser preenchido por JS) *@
            <div class="form-group">
                <label asp-for="ProfissionalId" class="control-label"></label>
                <select asp-for="ProfissionalId" class="form-control" disabled>
                    <option value="">Selecione o Profissional</option>
                </select>
            </div>

            @* CAMPO 5: SERVIÇO (Modificado para ser preenchido por JS) *@
            <div class="form-group">
                <label asp-for="ServicoId" class="control-label"></label>
                <select asp-for="ServicoId" class="form-control" disabled>
                    <option value="">Selecione o Serviço</option>
                </select>
            </div>

            <div class="form-group">
                <br />
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                <input type="submit" value="Agendar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Seletores dos Dropdowns
            var $barbearia = $('#BarbeariaId');
            var $profissional = $('#ProfissionalId');
            var $servico = $('#ServicoId');

            // Função para resetar Profissional e Serviço
            function resetDropdowns() {
                $profissional.empty().append('<option value="">Selecione o Profissional</option>').prop('disabled', true);
                $servico.empty().append('<option value="">Selecione o Serviço</option>').prop('disabled', true);
            }

            // 1. CARREGAR PROFISSIONAIS E SERVIÇOS AO MUDAR A BARBEARIA
            $barbearia.change(function () {
                var barbeariaId = $(this).val();
                resetDropdowns(); // Resetar ao mudar a Barbearia

                if (barbeariaId) {

                    // A) CARREGA PROFISSIONAIS
                    $.ajax({
                        url: '@Url.Action("GetProfissionaisPorBarbearia", "Agendamentos")',
                        type: "GET",
                        data: { barbeariaId: barbeariaId },
                        success: function (data) {
                            if (data && data.length > 0) {
                                $.each(data, function (i, item) {
                                    $profissional.append($('<option>', {
                                        value: item.id,
                                        text : item.nome
                                    }));
                                });
                                $profissional.prop('disabled', false);
                            }
                        },
                        error: function () {
                            console.error('Erro ao carregar profissionais.');
                        }
                    });

                    // B) CARREGA SERVIÇOS (Filtro por Barbearia ID)
                    $.ajax({
                        url: '@Url.Action("GetServicosPorBarbearia", "Agendamentos")',
                        type: "GET",
                        data: { barbeariaId: barbeariaId },
                        success: function (data) {
                            if (data && data.length > 0) {
                                $.each(data, function (i, item) {
                                    $servico.append($('<option>', {
                                        value: item.id,
                                        text : item.nome
                                    }));
                                });
                                $servico.prop('disabled', false);
                            }
                        },
                        error: function () {
                            console.error('Erro ao carregar serviços.');
                        }
                    });

                }
            });

            // Opcional: Se o Servico fosse vinculado ao Profissional, o código para $profissional.change() iria aqui.
            // Como o Servico é vinculado à Barbearia, o filtro é feito apenas na mudança da Barbearia (acima).
        });
    </script>
}