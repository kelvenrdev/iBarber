@model IEnumerable<iBarber.Models.Agendamento>

@{
    ViewData["Title"] = "Index";
}

<h1>Meus Agendamento</h1>

<p>
    <a asp-action="Create">Novo Agendamento</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DataHora)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profissional)
            </th>
            @* NOVA COLUNA: BARBEARIA *@
            <th>
                Barbearia
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Servico)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.DataHora)
                </td>
                <td>
                    @* Adicionando verificação nula para segurança *@
                    @(item.Usuario != null ? item.Usuario.Nome : "Cliente Não Encontrado")
                </td>
                <td>
                    @* Adicionando verificação nula para segurança *@
                    @(item.Profissional != null ? item.Profissional.Nome : "Profissional Não Encontrado")
                </td>
                @* NOVO DADO: NOME DA BARBEARIA *@
                <td>
                    @* Acesso via Agendamento -> Profissional -> Barbearia -> Nome *@
                    @(item.Profissional?.Barbearia != null ? item.Profissional.Barbearia.Nome : "Barbearia Não Encontrada")
                </td>
                <td>
                    @* Adicionando verificação nula para segurança *@
                    @(item.Servico != null ? item.Servico.Nome : "Serviço Não Encontrado")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>