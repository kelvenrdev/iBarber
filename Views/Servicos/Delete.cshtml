@model iBarber.Models.Servico

@{
    ViewData["Title"] = "Delete";
}

<h3>Tem certeza que deseja apagar a barbearia @Model.Nome</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Preco)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Preco)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DuracaoEmMinutos)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DuracaoEmMinutos)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Barbearia.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Barbearia.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Barbearia.Bairro)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Barbearia.Bairro)
        </dd>
    </dl>

    <form asp-action="Delete" class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger me-2"
                onclick="return confirm('Tem certeza que deseja excluir o serviço: ( @Model.Nome ) ?');">
            <i class="bi bi-trash"></i> Confirmar Exclusão
        </button>
    </form>
</div>
