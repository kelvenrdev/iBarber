@model iBarber.Models.Servico

@{
    ViewData["Title"] = "Criar Servico";
}

<h1>Criar Servico</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" class="form-control" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DuracaoEmMinutos" class="control-label"></label>
                <input asp-for="DuracaoEmMinutos" class="form-control" />
                <span asp-validation-for="DuracaoEmMinutos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BarbeariaId" class="control-label"></label>
                <select asp-for="BarbeariaId" class ="form-control" asp-items="ViewBag.BarbeariaId"></select>
            </div>
            <br />
            <div class="form-group">
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                <input type="submit" value="Criar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
